# Connection details for Elasticsearch migration
# Copy this file to .env and fill in your values.
# Do NOT commit .env with real credentials.

# --- Elastic Cloud (source) ---
# Use EITHER cloud-id OR url (not both)
ES_CLOUD_ID=
ES_CLOUD_URL=
ES_CLOUD_API_KEY=
# Or use username/password instead of API key:
# ES_CLOUD_USERNAME=elastic
# ES_CLOUD_PASSWORD=

# --- On-Prem Elasticsearch (target) ---
ES_ONPREM_HOST=https://your-onprem-host:9200
ES_ONPREM_USERNAME=elastic
ES_ONPREM_PASSWORD=
# ES_ONPREM_API_KEY=
# ES_ONPREM_CA_CERT=/path/to/http_ca.crt
